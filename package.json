
{
  "name": "postpilot",
  "version": "0.1.0",
  "private": true,
  "description": "A full-stack social content scheduling and automation platform.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  
"scripts": {
  "dev:api": "npm run start:dev --workspace=@postpilot/api",
  "build:api": "npm run build --workspace=@postpilot/api",
  "test:api": "npm run test --workspace=@postpilot/api",
  "test:e2e": "npm run test:e2e --workspace=@postpilot/api",
  "db:generate": "npm run prisma:generate --workspace=@postpilot/api",
  "db:validate": "npm run prisma:validate --workspace=@postpilot/api",
  "db:migrate": "npm run prisma:migrate --workspace=@postpilot/api",
  "db:deploy": "npm exec --workspace=@postpilot/api -- prisma migrate deploy",
  "infra:up": "docker compose up -d",
  "infra:stop": "docker compose stop"
},
  "keywords": [
    "social-media",
    "content-scheduler",
    "automation",
    "typescript",
    "saas"
  ],
  "license": "UNLICENSED"
}
